# Copy to .env.local and fill in. Everything here is optional: without it the
# editor, the embed and the marketing site all work, and the paid paths say
# so plainly rather than half-working.

# ---------------------------------------------------------------- Accounts
# Supabase project → Settings → API. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- Payments
# Razorpay → Settings → API Keys. Enable International Payments on the
# account to charge in USD as well as INR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay → Settings → Webhooks. A DIFFERENT secret from the key secret:
# it signs webhook bodies, and using the key secret here would accept
# forged webhooks. Point the webhook at /api/v1/billing/webhook and
# subscribe to payment.captured, payment.failed and order.paid.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Storage
# DOCKARO_DATA_DIR=.data/documents
# DOCKARO_BILLING_DIR=.data/billing
# DOCKARO_SITE_URL=https://dockaro.com
